# 追加/覆盖到 Dify 1.18.0 的 docker/.env
# 所有 CHANGE_ME / ChangeMe 都要替换成自己的值，不要把真实值提交到仓库。

EXPOSE_NGINX_PORT=8080
INIT_PASSWORD=ChangeMe2026!

# 让 Dify 的向量存储后端指向 seekdb（本作品没有创建知识库，
# 实际写入 seekdb 的是 inn 业务库，见 README）。
VECTOR_STORE=seekdb
COMPOSE_PROFILES=seekdb,postgresql
OCEANBASE_VECTOR_HOST=seekdb
OCEANBASE_VECTOR_PORT=2881
OCEANBASE_VECTOR_USER=root
OCEANBASE_VECTOR_PASSWORD=CHANGE_ME_SEEKDB_PASSWORD
OCEANBASE_VECTOR_DATABASE=test
SEEKDB_MEMORY_LIMIT=2G

# Dify 的 HTTP Request 节点默认走 Squid 代理；只放行本作品的后端容器。
SSRF_PROXY_ALLOW_PRIVATE_DOMAINS=inn-backend

# Dify 1.18 的 agent runtime 需要非空 token 才能启动，本作品不使用 Agent 节点。
DIFY_AGENT_LOCAL_SANDBOX_AUTH_TOKEN=CHANGE_ME_AGENT_TOKEN

# 与 Dify 应用环境变量 INN_SERVICE_TOKEN 保持一致。
INN_SERVICE_TOKEN=CHANGE_ME_INN_SERVICE_TOKEN
INN_ADMIN_TOKEN=CHANGE_ME_INN_ADMIN_TOKEN
